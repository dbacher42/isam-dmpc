import mujoco
import mujoco.viewer
import casadi as ca
import numpy as np
import matplotlib.pyplot as plt
import time

# ======================================================
# 1.  MuJoCo  XML Model
# ======================================================
xml_model = """
<mujoco>
    <option timestep="0.02" iterations="50" solver="Newton"/>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3"/>

        <!-- Square boundary -->
        <body>
            <geom type="box" size=".5 .01 .5" pos="0 .45 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".5 .01 .5" pos="0 -.45 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".01 .5 .5" pos=".45 0 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".01 .5 .5" pos="-.45 0 0" rgba="1 0 0 0.2"/>
        </body>

        <!-- Agents -->
        <body name="agent1" pos="0.4 0 0">
            <joint name="slide_x1" type="slide" axis="1 0 0" damping="0.1"/>
            <geom type="sphere" size="0.05" rgba="0 0 1 1"/>
        </body>

        <body name="agent2" pos="-0.4 0 0">
            <joint name="slide_x2" type="slide" axis="1 0 0" damping="0.1"/>
            <geom type="sphere" size="0.05" rgba="0 1 0 1"/>
        </body>

        <!-- starts outside the front face -->
        <body name="agent3" pos="0 0.45 0">
            <joint name="slide_y3" type="slide" axis="0 1 0" damping="0.1"/>
            <geom type="sphere" size="0.05" rgba="1 0 1 1"/>
        </body>
    </worldbody>

    <actuator>
        <motor joint="slide_x1" ctrlrange="-200 200"/>
        <motor joint="slide_x2" ctrlrange="-200 200"/>
        <motor joint="slide_y3" ctrlrange="-200 200"/>
    </actuator>
</mujoco>
"""

# ======================================================
# 2. Plug-and-Play Tube MPC Controller
# ======================================================
class PnPAgent:
    def __init__(self, A, B, K, horizon=8, d_safe=0.1, epsilon=0.05):
        self.A = A
        self.B = B
        self.K = K
        self.horizon = horizon
        self.d_safe = d_safe
        self.epsilon = epsilon
        self.nx = A.shape[0]
        self.nu = B.shape[1]
        self.solver = self._build_solver()

    def _build_solver(self):
        opti = ca.Opti()

        x = opti.variable(self.nx, self.horizon + 1)
        u = opti.variable(self.nu, self.horizon)

        x_init = opti.parameter(self.nx)
        x_other = opti.parameter(1)

        target = np.zeros(self.nx)
        cost = 0

        for k in range(self.horizon):
            # System dynamics
            opti.subject_to(x[:, k+1] == self.A @ x[:, k] + self.B @ u[:, k])

            # Cost function
            err = x[:, k] - target
            cost += 200 * ca.mtimes(err.T, err) + 0.05 * ca.mtimes(u[:, k].T, u[:, k])

            # Collision avoidance
            opti.subject_to(ca.fabs(x[0, k] - x_other) >= self.d_safe)

        # Tube constraint tightening
        opti.subject_to(opti.bounded(-0.45 + self.epsilon,
                                    x[0, :],
                                    0.45 - self.epsilon))

        opti.subject_to(x[:, 0] == x_init)
        opti.minimize(cost)

        opti.solver('ipopt', {
            'ipopt.print_level': 0,
            'ipopt.sb': 'yes',
            'print_time': 0
        })

        return opti.to_function('solver', [x_init, x_other], [u[:, 0], x[:, 0]])

# ======================================================
# 3.  Initialize Simulation
# ======================================================
model = mujoco.MjModel.from_xml_string(xml_model)
data = mujoco.MjData(model)

dt = 0.02

A = np.array([[1, dt], [0, 1]])
B = np.array([[0.5 * dt**2], [dt]])

agent1 = PnPAgent(A, B, K=np.array([-40.0, -10.0]))
agent2 = PnPAgent(A, B, K=np.array([-35.0, -8.0]))
agent3 = PnPAgent(A, B, K=np.array([-35.0, -10.0]))

data.qpos[0] = 0.4
data.qpos[1] = -0.4
data.qpos[2] = 0.45

# ======================================================
# 4. LOGGING
# ======================================================
time_log = []
x1_log, x2_log, x3_log = [], [], []
u1_log, u2_log, u3_log = [], [], []
dist12_log = []

print("Running Tube-based DMPC with 3 agents...")

# ======================================================
# 5. Simulation Loop
# ======================================================
with mujoco.viewer.launch_passive(model, data) as viewer:
    while viewer.is_running() and data.time < 20.0:
        step_start = time.time()

        # Add small disturbance
        disturbance = 0.002 * np.random.randn()
        data.qvel[:] += disturbance

        # Agent 1
        x1 = np.array([data.qpos[0], data.qvel[0]])
        other1 = (data.qpos[1] + data.qpos[2]) / 2
        u1_nom, x1_nom = agent1.solver(x1, other1)
        u1 = float(u1_nom) + agent1.K @ (x1 - np.array(x1_nom).flatten())

        # Agent 2
        x2 = np.array([data.qpos[1], data.qvel[1]])
        other2 = (data.qpos[0] + data.qpos[2]) / 2
        u2_nom, x2_nom = agent2.solver(x2, other2)
        u2 = float(u2_nom) + agent2.K @ (x2 - np.array(x2_nom).flatten())

        # Agent 3 (moves in y-direction)
        x3 = np.array([data.qpos[2], data.qvel[2]])
        other3 = (data.qpos[0] + data.qpos[1]) / 2
        u3_nom, x3_nom = agent3.solver(x3, other3)
        u3 = float(u3_nom) + agent3.K @ (x3 - np.array(x3_nom).flatten())

        # Apply control
        data.ctrl[0] = u1
        data.ctrl[1] = u2
        data.ctrl[2] = u3

        mujoco.mj_step(model, data)
        viewer.sync()

        # Logging
        time_log.append(data.time)
        x1_log.append(data.qpos[0])
        x2_log.append(data.qpos[1])
        x3_log.append(data.qpos[2])

        u1_log.append(u1)
        u2_log.append(u2)
        u3_log.append(u3)

        dist12_log.append(abs(data.qpos[0] - data.qpos[1]))

        if int(data.time * 10) % 5 == 0:
            print(f"{data.time:5.2f}s | x1={data.qpos[0]:.3f}, x2={data.qpos[1]:.3f}, x3={data.qpos[2]:.3f}")

        # Real-time sync
        elapsed = time.time() - step_start
        if dt - elapsed > 0:
            time.sleep(dt - elapsed)

print("Simulation complete.")

# ======================================================
# 6. PLOTS 
# ======================================================
epsilon = 0.05

plt.rcParams.update({"font.size": 10, "lines.linewidth": 1.5})

# --- POSITION PLOT ---
plt.figure(figsize=(6,3))

plt.plot(time_log, x1_log, label="Agent 1")
plt.plot(time_log, x2_log, label="Agent 2")
plt.plot(time_log, x3_log, label="Agent 3")

# Structure bounds
plt.axhline(0.45, linestyle='-', linewidth=1, label="Boundary")
plt.axhline(-0.45, linestyle='-', linewidth=1)

# Tube bounds
plt.axhline(0.45 - epsilon, linestyle='--', linewidth=1.5, label="Tube bound")
plt.axhline(-0.45 + epsilon, linestyle='--', linewidth=1.5)

# Shaded tube region
plt.fill_between(time_log,
                 -0.45 + epsilon,
                 0.45 - epsilon,
                 alpha=0.1)

plt.xlabel("Time [s]")
plt.ylabel("Position")
plt.title("Tube-based DMPC: Safety Envelope")
plt.legend(frameon=False)
plt.grid(True)
plt.tight_layout()
plt.savefig("tube_bounds.png", dpi=300)

# --- CONTROL PLOT ---
plt.figure(figsize=(5,3))
plt.plot(time_log, u1_log, label="u1")
plt.plot(time_log, u2_log, label="u2")
plt.plot(time_log, u3_log, label="u3")
plt.xlabel("Time [s]")
plt.ylabel("Control")
plt.title("Control Inputs")
plt.legend(frameon=False)
plt.grid(True)
plt.tight_layout()
plt.savefig("controls.png", dpi=300)

# --- DISTANCE PLOT ---
plt.figure(figsize=(5,3))
plt.plot(time_log, dist12_log)
plt.axhline(0.1, linestyle='--', label="Safe distance")
plt.xlabel("Time [s]")
plt.ylabel("Distance")
plt.title("Agent 1-2 Distance")
plt.legend(frameon=False)
plt.grid(True)
plt.tight_layout()
plt.savefig("distance.png", dpi=300)

plt.show()
