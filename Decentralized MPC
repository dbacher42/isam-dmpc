import mujoco
import mujoco.viewer
import casadi as ca
import numpy as np
import time

# =========================
# 1. MuJoCo XML Model
# =========================
xml_model = """
<mujoco>
    <option timestep="0.02" iterations="50" solver="Newton" tolerance="1e-10"/>
    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <body name="square" pos="0 0 0">
            <geom type="box" size=".5 .01 .5" pos="0 .45 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".5 .01 .5" pos="0 -.45 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".01 .5 .5" pos=".45 0 0" rgba="1 0 0 0.2"/>
            <geom type="box" size=".01 .5 .5" pos="-.45 0 0" rgba="1 0 0 0.2"/>
        </body>
        <body name="agent" pos="0.4 0 0">
            <joint name="slide_x" type="slide" axis="1 0 0" damping="0.1"/>
            <geom type="sphere" size="0.05" rgba="0 0 1 1"/>
        </body>
    </worldbody>
    <actuator>
        <motor joint="slide_x" name="thrust_x" ctrlrange="-200 200"/>
    </actuator>
</mujoco>
"""

# =========================
# 2. P&P MPC Controller
# =========================
class PnPAgent:
    def __init__(self, A, B, K, horizon=8):
        self.A = A
        self.B = B
        self.K = K
        self.nx = A.shape[0]
        self.nu = B.shape[1]
        self.horizon = horizon
        self.solver = self._build_solver()

    def _build_solver(self):
        opti = ca.Opti()
        x = opti.variable(self.nx, self.horizon + 1)
        u = opti.variable(self.nu, self.horizon)
        x_init = opti.parameter(self.nx)
        target = np.zeros(self.nx)

        cost = 0
        for k in range(self.horizon):
            opti.subject_to(x[:, k + 1] == self.A @ x[:, k] + self.B @ u[:, k])
            error = x[:, k] - target
            cost += 500 * ca.mtimes(error.T, error) + 0.01 * ca.mtimes(u[:, k].T, u[:, k])

        # Keep agent inside hollow square
        opti.subject_to(opti.bounded(-0.45, x[0, :], 0.45))
        opti.subject_to(x[:, 0] == x_init)
        opti.minimize(cost)

        opti.solver('ipopt', {'ipopt.print_level': 0, 'ipopt.sb': 'yes', 'print_time': 0})
        return opti.to_function('solve_mpc', [x_init], [u[:, 0], x[:, 0]])

# =========================
# 3. Initialize Simulation
# =========================
model = mujoco.MjModel.from_xml_string(xml_model)
data = mujoco.MjData(model)

# Start agent further from center to see motion
data.qpos[0] = 0.4
dt = 0.02
A = np.array([[1, dt], [0, 1]])
B = np.array([[0.5 * dt**2], [dt]])
K = np.array([-40.0, -10.0])
agent = PnPAgent(A, B, K)

print("Simulation ready. Agent will start moving inside the hollow square...")

# =========================
# 4. Simulation Loop
# =========================
with mujoco.viewer.launch_passive(model, data) as viewer:
    while viewer.is_running() and data.time < 20.0:  # run for 20s
        step_start = time.time()

        # Current state [position, velocity]
        x_curr = np.array([data.qpos[0], data.qvel[0]])

        # Try MPC control, fallback to proportional control if solver fails
        try:
            u_nom, x_nom = agent.solver(x_curr)
            u_final = float(u_nom) + K @ (x_curr - np.array(x_nom).flatten())
        except Exception:
            u_final = K @ (x_curr - np.zeros_like(x_curr))

        # Apply control and step simulation
        data.ctrl[0] = u_final
        mujoco.mj_step(model, data)

        # Update viewer
        viewer.sync()

        # Print log every 0.1s
        if int(data.time * 10) % 1 == 0:
            print(f"Time {data.time:.2f}s | Pos {data.qpos[0]:.4f} | Vel {data.qvel[0]:.4f} | Ctrl {u_final:.2f}")

        # Synchronize to real time
        elapsed = time.time() - step_start
        if dt - elapsed > 0:
            time.sleep(dt - elapsed)

print("Simulation finished. Agent dynamics observed successfully.")
