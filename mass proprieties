import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d.art3d import Poly3DCollection

# --------------------------
# Module = Parallelepiped
# --------------------------
class Module:
    def __init__(self, mass, dimensions, position):
        """
        mass: float -> mass of module [kg]
        dimensions: tuple (a, b, c) -> parallelepiped sides [m]
        position: tuple (x, y, z) -> COM location in structure coordinates [m]
        """
        self.mass = mass
        self.dimensions = np.array(dimensions)
        self.position = np.array(position)

# Inertia tensor about the module's own COM
        a, b, c = self.dimensions
        Ixx = (1/12) * mass * (b**2 + c**2)
        Iyy = (1/12) * mass * (a**2 + c**2)
        Izz = (1/12) * mass * (a**2 + b**2)
        self.inertia_tensor = np.diag([Ixx, Iyy, Izz])

    def get_corners(self):
        """Return 8 corner coordinates of the block (for plotting)"""
        a, b, c = self.dimensions
        cx, cy, cz = self.position
        # shift to edges (COM-centered)
        x = [cx - a/2, cx + a/2]
        y = [cy - b/2, cy + b/2]
        z = [cz - c/2, cz + c/2]

        corners = np.array([
            [x[0], y[0], z[0]],
            [x[1], y[0], z[0]],
            [x[1], y[1], z[0]],
            [x[0], y[1], z[0]],
            [x[0], y[0], z[1]],
            [x[1], y[0], z[1]],
            [x[1], y[1], z[1]],
            [x[0], y[1], z[1]]
        ])
        return corners


# --------------------------
# Structure = Collection of modules
# --------------------------
class Structure:
    def __init__(self, ax):
        self.mass = 0.0
        self.center_of_mass = np.zeros(3)
        self.inertia_tensor = np.zeros((3, 3))
        self.modules = []
        self.ax = ax

    def add_module(self, module: Module):
        """Add a new module and update mass properties"""
        self.modules.append(module)
        self._update_properties()
        self._update_plot()

    def _update_properties(self):
        """Recompute total mass, COM, and inertia tensor"""
        if not self.modules:
            return

# ---- Total Mass ----
        self.mass = sum(m.mass for m in self.modules)

# ---- Center of Mass ----
        weighted_positions = sum(m.mass * m.position for m in self.modules)
        self.center_of_mass = weighted_positions / self.mass

# ---- Inertia Tensor ----
        I_total = np.zeros((3, 3))
        for m in self.modules:
            d = m.position - self.center_of_mass
            shift_tensor = m.mass * (
                (np.dot(d, d) * np.eye(3)) - np.outer(d, d)
            )
            I_total += m.inertia_tensor + shift_tensor

        self.inertia_tensor = I_total

    def summary(self):
        """Print mass properties"""
        print("\n=== STRUCTURE MASS PROPERTIES ===")
        print("Total Mass [kg]:", self.mass)
        print("Center of Mass [m]:", self.center_of_mass)
        print("Inertia Tensor [kg·m²]:\n", self.inertia_tensor)

    def _update_plot(self):
        """Update 3D visualization in real time"""
        self.ax.cla()  # clear axes

        for i, m in enumerate(self.modules):
            corners = m.get_corners()
            faces = [
                [corners[j] for j in [0, 1, 2, 3]],
                [corners[j] for j in [4, 5, 6, 7]],
                [corners[j] for j in [0, 1, 5, 4]],
                [corners[j] for j in [2, 3, 7, 6]],
                [corners[j] for j in [1, 2, 6, 5]],
                [corners[j] for j in [4, 7, 3, 0]]
            ]
            self.ax.add_collection3d(
                Poly3DCollection(faces, alpha=0.3, linewidths=1, edgecolors="k")
            )
            self.ax.text(*m.position, f"M{i+1}", color="red")

        # Plot COM
        self.ax.scatter(*self.center_of_mass, color="blue", s=100, marker="o", label="COM")
        self.ax.legend()

        # Axes labels
        self.ax.set_xlabel("X [m]")
        self.ax.set_ylabel("Y [m]")
        self.ax.set_zlabel("Z [m]")
        self.ax.set_title("FloatBot Structure")

        plt.draw()
        plt.pause(0.1)  # pause for refresh


# --------------------------
# Interactive Program
# --------------------------
if __name__ == "__main__":
    plt.ion()  # interactive mode ON
    fig = plt.figure()
    ax = fig.add_subplot(111, projection="3d")

    spacecraft = Structure(ax)

    while True:
        print("\n--- Add a Module ---")
        mass = float(input("Enter mass [kg]: "))
        a = float(input("Enter length a [m]: "))
        b = float(input("Enter width b [m]: "))
        c = float(input("Enter height c [m]: "))
        x = float(input("Enter COM x-position [m]: "))
        y = float(input("Enter COM y-position [m]: "))
        z = float(input("Enter COM z-position [m]: "))

        # Add new module
        mod = Module(mass=mass, dimensions=(a, b, c), position=(x, y, z))
        spacecraft.add_module(mod)

        # Show updated values
        spacecraft.summary()

        cont = input("\nAdd another module? (y/n): ").strip().lower()
        if cont != "y":
            break

    plt.ioff()
    plt.show()
